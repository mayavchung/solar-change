# plt.style.use('../func/paper.mplstyle')

figure.titlesize: 24   # size of the figure title

figure.autolayout: False  # When True, automatically adjust subplot
                           # parameters to make the plot fit the figure
                           # using `tight_layout`
figure.constrained_layout.use: True  # When True, automatically make plot
                                       # elements fit on the figure. (Not
                                       # compatible with `autolayout`, above).
                                       
#set the font-size and size of things
figure.figsize: 7, 4
axes.labelsize: 14
axes.titlesize: 20
xtick.labelsize: 12
ytick.labelsize: 12
legend.fontsize: 12

grid.linewidth: 1
lines.linewidth: 2
lines.markersize: 7
#lines.markeredgewidth: 0

xtick.major.width: 1.3
ytick.major.width: 1.3
xtick.minor.width: 0.65
ytick.minor.width: 0.65

xtick.major.pad: 9.1
ytick.major.pad: 9.1

    
#axes.xmargin        : 0
#axes.ymargin        : 0

font.size: 12.0
text.color: black

axes.linewidth: 1
axes.grid: False
axes.axisbelow: True       # grid/ticks are below elements (e.g., lines, text)

xtick.direction: out
ytick.direction: out

grid.color: gray
grid.linestyle: --    # dashed line

#figure.facecolor: white
#figure.edgecolor: 0.50
